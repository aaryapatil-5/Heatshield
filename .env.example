# HeatShield AI Environment Configuration
# Copy this file to .env to customize settings

# Enable or disable live atmospheric queries to Open-Meteo API
OPEN_METEO_ENABLED=true

# Default physical thermal stress metric: 'heat_index', 'wbgt', or 'utci'
DEFAULT_THERMAL_METRIC=heat_index

# Set to 1 to force scikit-learn instead of built-in fast decision forest
USE_SKLEARN=0

# Backend service port
PORT=8000

# Optional Open-Meteo API Key (not required for standard free tier)
# OPEN_METEO_API_KEY=
